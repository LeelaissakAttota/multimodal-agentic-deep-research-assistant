# Environment variables for Multimodal Agentic Deep Research Assistant
# Copy this file to .env and adjust the values as needed.
# Do not commit .env to version control.

# Application settings
MADRA_APP_NAME=Multimodal Agentic Deep Research Assistant
MADRA_ENVIRONMENT=development
MADRA_DEBUG=false
MADRA_VERSION=0.1.0

# API settings
MADRA_API_HOST=0.0.0.0
MADRA_API_PORT=8000

# Logging settings
MADRA_LOG_LEVEL=INFO

# Phase 6 runtime limits
MADRA_MAX_RESEARCH_ITERATIONS=3
MADRA_MAX_TOOL_CALLS_PER_ITERATION=20
MADRA_MAX_TOOL_CALLS_TOTAL=60
MADRA_MAX_MODEL_CALLS_PER_ITERATION=15
MADRA_MAX_MODEL_CALLS_TOTAL=45
MADRA_MAX_TOKENS_PER_CALL=4000
MADRA_MAX_TOKENS_TOTAL=50000
MADRA_MAX_RESEARCH_TIME_SECONDS=300
MADRA_MAX_TOOL_CALL_TIME_SECONDS=30
MADRA_MAX_MODEL_CALL_TIME_SECONDS=60
MADRA_MAX_EXTERNAL_API_CALLS=10
MADRA_MAX_TOOL_RETRY_ATTEMPTS=2
MADRA_MAX_MODEL_RETRY_ATTEMPTS=2
MADRA_RETRY_BACKOFF_SECONDS=0.1
MADRA_RETRY_BACKOFF_MAX_SECONDS=2.0
MADRA_EMERGENCY_STOP=false
