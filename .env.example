# Settings are read from ./.env (override the path with the DEEP_RESEARCH_ENV_FILE environment variable).
# Environment variables for Multimodal Agentic Deep Research Assistant
# Copy this file to .env and adjust the values as needed.
# Do not commit .env to version control.

# Application settings
DEEP_RESEARCH_APP_NAME=Multimodal Agentic Deep Research Assistant
DEEP_RESEARCH_ENVIRONMENT=development
DEEP_RESEARCH_DEBUG=false
DEEP_RESEARCH_VERSION=0.1.0

# API settings
DEEP_RESEARCH_API_HOST=0.0.0.0
DEEP_RESEARCH_API_PORT=8000

# Logging settings
DEEP_RESEARCH_LOG_LEVEL=INFO
# json (default) or text (readable one-line logs for local demos)
DEEP_RESEARCH_LOG_FORMAT=json

# Phase 6 runtime limits
DEEP_RESEARCH_MAX_RESEARCH_ITERATIONS=3
DEEP_RESEARCH_MAX_TOOL_CALLS_PER_ITERATION=20
DEEP_RESEARCH_MAX_TOOL_CALLS_TOTAL=60
DEEP_RESEARCH_MAX_MODEL_CALLS_PER_ITERATION=15
DEEP_RESEARCH_MAX_MODEL_CALLS_TOTAL=45
DEEP_RESEARCH_MAX_TOKENS_PER_CALL=4000
DEEP_RESEARCH_MAX_TOKENS_TOTAL=50000
DEEP_RESEARCH_MAX_RESEARCH_TIME_SECONDS=420   # live agentic runs take ~3-4 min; the last 60 s are kept for the report
DEEP_RESEARCH_MAX_TOOL_CALL_TIME_SECONDS=30
DEEP_RESEARCH_MAX_MODEL_CALL_TIME_SECONDS=60
DEEP_RESEARCH_MAX_EXTERNAL_API_CALLS=10
DEEP_RESEARCH_MAX_TOOL_RETRY_ATTEMPTS=2
DEEP_RESEARCH_MAX_MODEL_RETRY_ATTEMPTS=2
DEEP_RESEARCH_RETRY_BACKOFF_SECONDS=0.1
DEEP_RESEARCH_RETRY_BACKOFF_MAX_SECONDS=2.0
DEEP_RESEARCH_EMERGENCY_STOP=false

# Optional live providers (leave empty to stay fully offline)
DEEP_RESEARCH_OPENROUTER_API_KEY=
# Model selection: "auto" (default) queries OpenRouter /models at runtime,
# ranks currently available :free models, and falls back on 404/429/unavailable.
# Pin a specific :free slug to try that one first, then auto-fallback.
DEEP_RESEARCH_OPENROUTER_MODEL=auto
DEEP_RESEARCH_OPENROUTER_VISION_MODEL=auto
DEEP_RESEARCH_OPENROUTER_MODEL_CACHE_SECONDS=21600
# Persisted free-model selection (JSON, never contains the key). Empty = per-user cache dir; 'off' disables.
DEEP_RESEARCH_OPENROUTER_MODEL_CACHE_PATH=
# Top free models per kind to latency-probe on discovery (0 = no probing), and probe timeout.
DEEP_RESEARCH_OPENROUTER_PROBE_COUNT=3
DEEP_RESEARCH_OPENROUTER_PROBE_TIMEOUT_SECONDS=8
DEEP_RESEARCH_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEP_RESEARCH_NVIDIA_API_KEY=
DEEP_RESEARCH_HUGGINGFACE_API_KEY=

# Research mode: offline (deterministic, no network, default) | live
DEEP_RESEARCH_RESEARCH_MODE=offline
# Live search: auto (default) tries free sources in order and skips blocked ones
# (DDG HTML → DDG Lite → Wikipedia search → DDG Instant Answer). Optional Tavily first
# when DEEP_RESEARCH_TAVILY_API_KEY is set. Explicit: duckduckgo | tavily
DEEP_RESEARCH_SEARCH_PROVIDER=auto
DEEP_RESEARCH_TAVILY_API_KEY=
DEEP_RESEARCH_LIVE_MAX_SEARCH_RESULTS=5
DEEP_RESEARCH_LIVE_MAX_FETCH_PAGES=2
# Keyless public-source tools the planner may use in live mode: all | none | comma list of
# academic_search,youtube_transcript,reddit_search,commons_image_search,hackernews_search,bluesky_search,stackexchange_search
DEEP_RESEARCH_LIVE_SOURCE_TOOLS=all


# Supervised-control API (python -m deep_research.control.server, 127.0.0.1 only).
# Bearer token, at least 16 characters. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
DEEP_RESEARCH_CONTROL_TOKEN=
# Initial default for the dashboard "Step-by-step approval" toggle (off). Once saved in Settings, the saved value wins.
# DEEP_RESEARCH_APPROVAL_MODE=false

# Optional: Reddit official API (app-only OAuth, "script"/"web" app at reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=python:deep-research-assistant:0.2 (by /u/yourname)

# Optional: Bluesky login, used only if the keyless public AppView refuses search from your network.
# Use an app password (Settings > Privacy and security > App passwords), never your main password.
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# ----- Optional scale backends (Phase 6). All off by default; see docs/SCALE.md and docker-compose.yml. -----
# MDRA_REDIS_URL=redis://localhost:6379/0           # job queue (pip extra: queue); run deep-research-worker
# MDRA_DATABASE_URL=postgresql://mdra:<password>@localhost:5433/mdra   # sessions in Postgres (extra: postgres)
# MDRA_S3_BUCKET=mdra-artifacts                     # saved exports in MinIO/S3 (extra: s3)
# MDRA_S3_ENDPOINT=http://localhost:9000
# MDRA_S3_ACCESS_KEY=
# MDRA_S3_SECRET_KEY=
# MDRA_ARTIFACTS_DIR=data/artifacts                 # local fallback folder
# MDRA_OTEL_EXPORTER=off                            # off | console | otlp (extra: tracing)
# MDRA_OTEL_ENDPOINT=http://localhost:4318/v1/traces
# MDRA_TRACE_STORE=off                              # off | sqlite | jsonl: per-run trace timeline in the dashboard
# MDRA_TRACE_DIR=data/traces
# MDRA_TRACE_MAX_AGE_DAYS=14                        # prune runs whose last span is older (0 = no age limit)
# MDRA_TRACE_MAX_RUNS=500                           # keep only the newest N runs (0 = no limit)
# MDRA_TRACE_PRUNE_INTERVAL_SECONDS=3600            # prune at startup, then at most this often on write
# MDRA_AB_CONFIG=                                   # A/B experiment JSON or path to a JSON file
# MDRA_NEO4J_URI=bolt://localhost:7687              # optional knowledge-graph sync (extra: graph)
# MDRA_NEO4J_USER=neo4j
# MDRA_NEO4J_PASSWORD=
# MDRA_GRAPH_RAG=false                              # expand report-chat RAG hits through graph neighbours
# MDRA_GRAPH_AUTO_SYNC=false                        # MERGE each finished run into Neo4j
# MDRA_GRAPH_BACKEND=auto                           # auto | neo4j | local
# MDRA_GRAPH_WEIGHT=0.5
# MDRA_GRAPH_MAX_NEIGHBOURS=4
# MDRA_GRAPH_TIMEOUT_SECONDS=5
# docker-compose host ports (bound to 127.0.0.1; Postgres defaults to 5433 to avoid a local PostgreSQL on 5432):
# docker compose passwords (required by docker-compose.yml; no defaults are committed). Pick your own local
# values; keep the same value in MDRA_DATABASE_URL / MDRA_S3_SECRET_KEY / MDRA_NEO4J_PASSWORD. An existing
# postgres-data volume keeps the password it was created with, so reuse that value for an existing setup.
# MDRA_PG_PASSWORD=
# MDRA_MINIO_PASSWORD=
# MDRA_NEO4J_PASSWORD=   # also used by the app (see above)
# MDRA_PG_PORT=5433
# MDRA_REDIS_PORT=6379
# MDRA_MINIO_PORT=9000
# MDRA_MINIO_CONSOLE_PORT=9001
# MDRA_OTEL_PORT=4318
# MDRA_NEO4J_HTTP_PORT=7474
# MDRA_NEO4J_BOLT_PORT=7687
