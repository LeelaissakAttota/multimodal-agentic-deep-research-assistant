# Environment variables for Multimodal Agentic Deep Research Assistant
# Copy this file to .env and adjust the values as needed.
# Do not commit .env to version control.

# Application settings
MADRA_APP_NAME=Multimodal Agentic Deep Research Assistant
MADRA_ENVIRONMENT=development
MADRA_DEBUG=false
MADRA_VERSION=0.1.0

# API settings
MADRA_API_HOST=0.0.0.0
MADRA_API_PORT=8000

# Logging settings
MADRA_LOG_LEVEL=INFO

# Phase 6 runtime limits
MADRA_MAX_RESEARCH_ITERATIONS=3
MADRA_MAX_TOOL_CALLS_PER_ITERATION=20
MADRA_MAX_TOOL_CALLS_TOTAL=60
MADRA_MAX_MODEL_CALLS_PER_ITERATION=15
MADRA_MAX_MODEL_CALLS_TOTAL=45
MADRA_MAX_TOKENS_PER_CALL=4000
MADRA_MAX_TOKENS_TOTAL=50000
MADRA_MAX_RESEARCH_TIME_SECONDS=300
MADRA_MAX_TOOL_CALL_TIME_SECONDS=30
MADRA_MAX_MODEL_CALL_TIME_SECONDS=60
MADRA_MAX_EXTERNAL_API_CALLS=10
MADRA_MAX_TOOL_RETRY_ATTEMPTS=2
MADRA_MAX_MODEL_RETRY_ATTEMPTS=2
MADRA_RETRY_BACKOFF_SECONDS=0.1
MADRA_RETRY_BACKOFF_MAX_SECONDS=2.0
MADRA_EMERGENCY_STOP=false

# Optional live providers (leave empty to stay fully offline)
MADRA_OPENROUTER_API_KEY=
# Model selection: "auto" (default) queries OpenRouter /models at runtime,
# ranks currently available :free models, and falls back on 404/429/unavailable.
# Pin a specific :free slug to try that one first, then auto-fallback.
MADRA_OPENROUTER_MODEL=auto
MADRA_OPENROUTER_VISION_MODEL=auto
MADRA_OPENROUTER_MODEL_CACHE_SECONDS=21600
# Persisted free-model selection (JSON, never contains the key). Empty = per-user cache dir; 'off' disables.
MADRA_OPENROUTER_MODEL_CACHE_PATH=
# Top free models per kind to latency-probe on discovery (0 = no probing), and probe timeout.
MADRA_OPENROUTER_PROBE_COUNT=3
MADRA_OPENROUTER_PROBE_TIMEOUT_SECONDS=8
MADRA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MADRA_NVIDIA_API_KEY=
MADRA_HUGGINGFACE_API_KEY=

# Research mode: offline (deterministic, no network, default) | live
MADRA_RESEARCH_MODE=offline
# Live search: auto (default) tries free sources in order and skips blocked ones
# (DDG HTML → DDG Lite → Wikipedia search → DDG Instant Answer). Optional Tavily first
# when MADRA_TAVILY_API_KEY is set. Explicit: duckduckgo | tavily
MADRA_SEARCH_PROVIDER=auto
MADRA_TAVILY_API_KEY=
MADRA_LIVE_MAX_SEARCH_RESULTS=5
MADRA_LIVE_MAX_FETCH_PAGES=2

